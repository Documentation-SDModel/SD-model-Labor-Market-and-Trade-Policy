///---\\\
:GRAPH Labor_Force
:TITLE Labor Force = Employment + Unemployement
:SCALE
:VAR Labor Force
:DATASET *1
:LINE-WIDTH 1
:VAR Unemployed Workers
:DATASET *1
:LINE-WIDTH 1
:VAR Employment
:DATASET *1
:LINE-WIDTH 1

:GRAPH Worforce_Companies
:TITLE Worforce Companies
:SCALE
:VAR Employees Company A
:DATASET *1
:LINE-WIDTH 1
:VAR Employees Company B
:DATASET *1
:LINE-WIDTH 1
:VAR Employees Company C
:DATASET *1
:LINE-WIDTH 1

:GRAPH turnover_rate
:TITLE Turnover Annual Rate Companies
:SCALE
:VAR Annual turnover rate A
:DATASET *1
:LINE-WIDTH 1
:VAR Annual turnover rate B
:DATASET *1
:LINE-WIDTH 1
:VAR Annual turnover rate C
:DATASET *1
:LINE-WIDTH 1

:GRAPH Recruitmen_A
:TITLE Recruitment A
:SCALE
:VAR Hiring A
:DATASET *1
:LINE-WIDTH 1
:VAR Leaving B
:DATASET *1
:LINE-WIDTH 1
:VAR Leaving C
:DATASET *1
:LINE-WIDTH 1

:GRAPH recruitment_B
:TITLE Recruitment B
:SCALE
:VAR Leaving A
:DATASET *1
:LINE-WIDTH 1
:VAR Hiring B
